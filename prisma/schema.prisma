datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String           @id @default(cuid())
  fullName           String
  username           String           @unique
  email              String           @unique
  phone              String?
  dateOfBirth        DateTime?
  passwordHash       String
  avatarUrl          String?
  bio                String?
  weightUnit         String           @default("KG") // "KG" | "LBS"
  defaultRestSeconds Int              @default(90)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workouts           Workout[]
  routines           Routine[]
  customExercises    Exercise[]
  personalRecords    PersonalRecord[]
  followers          Follow[]         @relation("UserFollowers")
  following          Follow[]         @relation("UserFollowing")
  likes              WorkoutLike[]
  comments           WorkoutComment[]

  @@index([username])
  @@index([email])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Exercise {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  category           String            @default("BARBELL") // BARBELL, DUMBBELL, MACHINE, CABLE, BODYWEIGHT, OTHER
  primaryMuscle      String            // CHEST, BACK, SHOULDERS, BICEPS, TRICEPS, QUADS, HAMSTRINGS, GLUTES, CALVES, CORE
  secondaryMuscles   String[]          @default([])
  instructions       String?
  defaultRestSeconds Int               @default(90)
  isCustom           Boolean           @default(false)
  userId             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises   RoutineExercise[]
  workoutExercises   WorkoutExercise[]
  personalRecords    PersonalRecord[]

  @@index([name])
  @@index([primaryMuscle])
  @@index([category])
  @@index([userId])
}

model Routine {
  id          String            @id @default(cuid())
  userId      String
  title       String
  description String?
  folder      String?           // e.g. "Push Pull Legs", "Upper Lower"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   RoutineExercise[]
  workouts    Workout[]

  @@index([userId])
  @@index([folder])
}

model RoutineExercise {
  id          String   @id @default(cuid())
  routineId   String
  exerciseId  String
  order       Int      @default(0)
  targetSets  Int      @default(3)
  targetReps  Int?
  restSeconds Int      @default(90)
  notes       String?

  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([exerciseId])
}

model Workout {
  id              String            @id @default(cuid())
  userId          String
  routineId       String?
  title           String
  notes           String?
  startTime       DateTime          @default(now())
  endTime         DateTime?
  durationSeconds Int               @default(0)
  totalVolumeKg   Float             @default(0)
  totalSets       Int               @default(0)
  isCompleted     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine         Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  exercises       WorkoutExercise[]
  personalRecords PersonalRecord[]
  likes           WorkoutLike[]
  comments        WorkoutComment[]

  @@index([userId])
  @@index([startTime])
  @@index([isCompleted])
  @@index([userId, startTime])
}

model WorkoutExercise {
  id         String       @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int          @default(0)
  notes      String?
  supersetId String?

  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets       WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  setType           String          @default("NORMAL") // NORMAL, WARMUP, DROP, FAILURE
  weightKg          Float           @default(0)
  reps              Int             @default(0)
  rpe               Float?
  isCompleted       Boolean         @default(false)
  completedAt       DateTime?
  previousWeightKg  Float?
  previousReps      Int?

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@index([isCompleted])
}

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  workoutId  String?
  type       String   // "ESTIMATED_1RM" | "MAX_WEIGHT" | "MAX_VOLUME"
  value      Float
  reps       Int?
  achievedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout    Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseId])
}

model WorkoutLike {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([workoutId])
  @@index([userId])
}

model WorkoutComment {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  content   String
  createdAt DateTime @default(now())

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([userId])
}
